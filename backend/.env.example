# For running the API directly (without Docker), copy to backend/.env.
GYMPULSE_DATABASE_URL=postgresql+psycopg://gympulse:gympulse@localhost:5432/gympulse
GYMPULSE_ENVIRONMENT=development
GYMPULSE_JWT_SECRET=replace-with-a-long-random-string
GYMPULSE_ACCESS_TOKEN_MINUTES=15
GYMPULSE_REFRESH_TOKEN_DAYS=30

# Testing check-in from a computer (no GPS, location guessed from Wi-Fi): accept imprecise
# locations. Create a test gym with "Koristi moju trenutnu lokaciju" so it sits where the
# computer thinks it is. Never set this on a real server.
# GYMPULSE_CHECKIN_MAX_ACCURACY_M=5000
